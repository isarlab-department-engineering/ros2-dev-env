<?xml version="1.0"?>
<package format="3">
  <name>turtlebot3_docker_bringup</name>
  <version>0.0.1</version>
  <description>Docker launch configuration for TurtleBot3 Gazebo Classic.</description>
  <maintainer email="alberto@example.com">Alberto</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>